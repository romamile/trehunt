/* ===== BASIC LAYOUT ===== */
#reader {
  width: 320px;
  max-width: 100%;
  margin-bottom: 1rem;
}

#result-box {
  border: 1px solid #444;
  background: #222;
  color: white;
  padding: 0.5rem 1rem;
  min-width: 320px;
  text-align: center;
  border-radius: 6px;
  margin-bottom: 1rem;
}

#result-label {
  font-weight: bold;
}

/* ===== OVERLAY BASE ===== */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: none;
  justify-content: center;
  align-items: center;
  color: white;
  text-align: center;
  z-index: 1000;
}

/* Error overlay */
#error-overlay {
  background-color: rgba(0, 0, 0, 0.7);
}

.error-message {
  background: #ff4f4f;
  padding: 20px;
  border-radius: 8px;
  font-size: 18px;
  max-width: 320px;
  box-shadow: 0 0 15px rgba(0, 0, 0, 0.5);
}

/* Success overlay */
#success-overlay {
  background-color: rgba(0, 0, 0, 0.7);
}

.success-message {
  position: relative;
  background: #2ecc71;
  padding: 30px;
  border-radius: 8px;
  font-size: 20px;
  width: 80%;
  max-width: 350px;
  box-shadow: 0 0 20px rgba(0, 0, 0, 0.6);
}

/* Close button */
.close-btn {
  position: absolute;
  top: 8px;
  right: 10px;
  background: transparent;
  border: none;
  color: white;
  font-size: 24px;
  cursor: pointer;
}

.close-btn:hover {
  color: #ffe6e6;
}

/* Next clue link */
#next-link {
  color: #ffe97f;
  font-weight: bold;
  text-decoration: underline;
}

#next-link:hover {
  color: #fff7c2;
}
